# ── GULMOHAR GROUND — online play in 2 minutes ─────────────────────────────
# 1. Create a free project at https://supabase.com (no config needed)
# 2. Project Settings → API → copy these two values
# 3. Paste them below (this file is the ONLY place keys are configured —
#    there is no in-game paste form), then restart `bun run dev`
#    (Next.js only reads .env.local at boot)
#
# Realtime broadcast + presence work out of the box on every new project.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
